---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import BookingCta from '../components/BookingCta.astro';
import slide1 from '../assets/images/menstrual-phase-1.jpg';
import slide2 from '../assets/images/menstrual-phase-2.jpg';
import slide3 from '../assets/images/menstrual-phase-3.jpg';
import slide4 from '../assets/images/menstrual-phase-4.jpg';
import slide5 from '../assets/images/menstrual-phase-5.jpg';
import slide6 from '../assets/images/menstrual-phase-6.jpg';
import plates from '../assets/images/service-diet-lifestyle-analysis.jpg';

const slides = [
  { src: slide1, alt: 'Illustration: What to eat during your menstrual phase' },
  { src: slide2, alt: 'The physiology: during menstruation, oestrogen and progesterone are at their lowest' },
  { src: slide3, alt: 'Rebuild what’s lost: focus on replenishing iron, zinc and magnesium' },
  { src: slide4, alt: 'Soothe inflammation and support digestion' },
  { src: slide5, alt: 'Nourish the nervous system' },
  { src: slide6, alt: 'Closing reflection: this phase is an invitation to retreat and rebuild' },
];
---

<BaseLayout title="Projects">
  <PageHeader
    eyebrow="Collaboration"
    title="What to Eat During your Menstrual Phase"
    size="md"
    image={slide1}
    imageAlt="Illustration of a woman carrying beetroot, by Laurel Molly"
  >
    <p>
      A collaboration post with Bristol Illustrator Laurel Molly - click to visit her website <a
        href="https://laurelmolly.co.uk/"
        target="_blank"
        rel="noopener">here.</a
      >
    </p>
  </PageHeader>

  <section class="section section--cream" aria-label="About this collaboration">
    <div class="container--narrow article">
      <p class="article__lead">
        Most women are taught to push through their period. To treat fatigue, cramps, and cravings as inconveniences to
        suppress. But the menstrual phase isn’t a weakness. It’s an internal reset.
      </p>
      <p>
        When estrogen and progesterone fall, inflammation rises, and your body begins the work of cellular repair. What it
        needs most is warmth, minerals, and gentle nourishment , not depletion. This is the phase for slow-cooked foods,
        deep hydration, and nutrients that rebuild: iron, magnesium, zinc, and omega-3s. It’s also the time to eat in
        rhythm. Smaller, frequent meals if digestion feels sensitive, and comforting, whole ingredients that keep your
        blood sugar steady. When you eat with your cycle, not against it, you stop fighting your body and start
        collaborating with it. That’s when symptoms soften, energy stabilises, and your period becomes a time of release
        rather than resistance.
      </p>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Illustrated by Laurel Molly</p>
        <h2 class="h2" id="gallery-title">The series</h2>
      </div>
      <ul class="gallery">
        {
          slides.map((slide) => (
            <li class="gallery__item">
              <Image
                src={slide.src}
                alt={slide.alt}
                widths={[360, 540, 720, 1080]}
                sizes="(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 100vw"
                class="media-cover"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookingCta tone="sage" image={plates} imageAlt="Plates of colourful food being shared at a table" />
</BaseLayout>

<style>
  .article > * + * {
    margin-top: 1.2em;
  }

  .article__lead {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    line-height: 1.25;
    text-wrap: balance;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2.5vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gallery__item {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--cream);
  }

  @media (max-width: 1099.98px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639.98px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
