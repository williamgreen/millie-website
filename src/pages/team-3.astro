---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import BookingCta from '../components/BookingCta.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import step1 from '../assets/images/step-1-free-call.jpg';
import step2 from '../assets/images/step-2-initial-consultation.jpg';
import step3 from '../assets/images/amelia-reading-menu.jpg';
import vegetables from '../assets/images/vegetable-tray.png';
---

<BaseLayout title="How I Work">
  <PageHeader eyebrow="Working together" title="How I work">
    <Fragment slot="actions">
      <a class="btn" href="/service-page/free-phone-consultation-1">Book a Free Call <Arrow /></a>
      <a class="btn btn--outline" href="/general-1">See packages</a>
    </Fragment>
  </PageHeader>

  <section class="section section--cream" aria-label="Steps">
    <div class="container">
      <ol class="steps">
        <li class="step">
          <div class="step__media">
            <Image
              src={step1}
              alt="Amelia reading by a café window"
              widths={[360, 540, 720]}
              sizes="(min-width: 1024px) 30vw, (min-width: 700px) 45vw, 100vw"
              class="media-cover"
            />
          </div>
          <div class="step__body">
            <p class="eyebrow">Step 1</p>
            <h2 class="h3">Book a Free Call</h2>
            <p>
              Book in a free 20 minute consultation over the phone to chat about your symptoms. In this phone call we
              can also explore the options for working together and I can explain how my approach can be applied to your
              unique situation, offering some potential routes to begin improvements. I work mostly through zoom so where
              you're based doesn't matter, as long as you have access to Wi-Fi.
            </p>
          </div>
        </li>

        <li class="step">
          <div class="step__media">
            <Image
              src={step2}
              alt="Amelia writing notes on paper"
              widths={[360, 540, 720]}
              sizes="(min-width: 1024px) 30vw, (min-width: 700px) 45vw, 100vw"
              class="media-cover"
              style="object-position: 50% 30%"
            />
          </div>
          <div class="step__body">
            <p class="eyebrow">Step 2</p>
            <h2 class="h3">Initial Consulation</h2>
            <h3 class="step__sub">Pre appointment health questionnaire:</h3>
            <p>
              If you decide you would like to work with me, I will send you a detailed health questionnaire for me to get
              all the information I need before the session. This will include any medications you are on, family health
              history and your main health concerns.
            </p>
            <p>
              All new clients will start with a 75 - 90 minutes session in which we will use the questionnaire to talk
              through and delve deeper into your current health status and lifestyle. The information gained in the
              pre-appointment questionnaire will allow me a more detailed picture to best help and allow us to better
              focus our time together.
            </p>
            <h3 class="step__sub">You will receive:</h3>
            <ul class="ticks">
              <li>A bespoke plan of food &amp; lifestyle recommendations, tailored to your needs</li>
              <li>Recommendations for high-quality supplements, if required.</li>
              <li>Recommendations for functional testing, if necessary.</li>
              <li>A clear focus until we meet again.</li>
            </ul>
          </div>
        </li>

        <li class="step">
          <div class="step__media">
            <Image
              src={step3}
              alt="Amelia reading a menu at a restaurant table"
              widths={[360, 540, 720]}
              sizes="(min-width: 1024px) 30vw, (min-width: 700px) 45vw, 100vw"
              class="media-cover"
              style="object-position: 50% 15%"
            />
          </div>
          <div class="step__body">
            <p class="eyebrow">Step 3</p>
            <h2 class="h3">Follow-up</h2>
            <p>
              Six weeks later we will meet for a follow up consultation - this is a chance to discuss what's working for
              you and what needs to be adjusted. We can build on the original plan and introduce more points.
            </p>
            <ul class="ticks">
              <li>
                Interpretation and analysis of test results and new points on the plan to reflect the information
                highlighted.
              </li>
              <li>A chance to discuss any new symptoms</li>
              <li>Additional research</li>
              <li>A clear plan to go away with or until we meet again</li>
              <li>Email support, if required</li>
            </ul>
            <p>
              From here, the amount of follow up sessions and the length in-between will be on a case by case basis. We
              can be flexible and discuss what will work for you.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="contact-title">
    <div class="container contact">
      <div class="contact__intro">
        <p class="eyebrow">Contact</p>
        <h2 class="h2" id="contact-title">Get in touch</h2>
      </div>
      <ul class="contact__cards">
        <li class="contact__card">
          <p class="eyebrow">Email</p>
          <a class="contact__value" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li class="contact__card">
          <p class="eyebrow">Call</p>
          <a class="contact__value" href={`tel:+44${site.phone.slice(1)}`}>{site.phone}</a>
        </li>
        <li class="contact__card">
          <p class="eyebrow">Follow</p>
          <span class="contact__links">
            <a class="contact__value" href={site.instagram.url} target="_blank" rel="noopener">Instagram</a>
            <a class="contact__value" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          </span>
        </li>
      </ul>
    </div>
  </section>

  <BookingCta tone="lime" image={vegetables} imageAlt="A tray of fresh vegetables" />
</BaseLayout>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--sage);
  }

  .step__media {
    aspect-ratio: 4 / 3;
  }

  .step__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 36px);
  }

  .step__body .eyebrow {
    margin-bottom: 0;
  }

  .step__body .h3 {
    margin-bottom: 4px;
  }

  .step__sub {
    margin-top: 8px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-body);
    line-height: 1.4;
  }

  .step .ticks {
    gap: 10px;
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }

  .contact__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact__card {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--cream);
  }

  .contact__card .eyebrow {
    margin-bottom: 10px;
  }

  .contact__value {
    font-size: 17px;
    font-weight: 400;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact__value:hover {
    text-decoration: underline;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  @media (max-width: 1099.98px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .step__media {
      aspect-ratio: auto;
      min-height: 100%;
    }

    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 699.98px) {
    .step {
      display: flex;
    }

    .step__media {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .contact__cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
