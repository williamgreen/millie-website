---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { events, type SiteEvent } from '../../data/events';

export const getStaticPaths = (() =>
  events.map((event) => ({ params: { slug: event.slug }, props: { event } }))) satisfies GetStaticPaths;

interface Props {
  event: SiteEvent;
}

const { event } = Astro.props;
const pageUrl = `${site.url}/event-details-registration/${event.slug}`;
const shareText = 'Check out this event. Hope to see you there!';
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
  x: `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareText)}`,
  linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(pageUrl)}`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.start,
  endDate: event.end,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: event.venue, address: event.address.replace(/^Bedminster, /, '') },
};
---

<BaseLayout title={event.title} description={event.about} image={event.image} jsonLd={jsonLd}>
  <article class="event">
    <header class="event__head">
      <div class="event__intro">
        <h1 class="event__title">{event.title}</h1>
        <p class="event__when">
          <span>{event.shortDate}</span><span class="event__sep" aria-hidden="true">|</span><span>{event.venue}</span>
        </p>
        <hr class="event__rule" />
        <p class="event__status">{event.ticketsOnSale ? 'Tickets on sale' : 'Tickets are not on sale'}</p>
        <a class="event__other" href="/">See other events</a>
      </div>
      <div class="event__image">
        <Image
          src={event.image}
          alt={event.title}
          widths={[480, 980, 1225]}
          sizes="(min-width: 1024px) 979px, 100vw"
          loading="eager"
        />
      </div>
    </header>

    <div class="event__body">
      <section aria-labelledby="time-title">
        <h2 class="event__heading" id="time-title">Time &amp; Location</h2>
        <p>{event.when}</p>
        <p>{event.address}</p>
      </section>

      <section aria-labelledby="about-title">
        <h2 class="event__heading" id="about-title">About the event</h2>
        <p class="event__about">{event.about}</p>
      </section>

      <section aria-labelledby="share-title">
        <h2 class="event__heading" id="share-title">Share this event</h2>
        <ul class="event__share">
          <li>
            <a href={share.facebook} target="_blank" rel="noopener" aria-label="Share event on Facebook">
              <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z"
                ></path></svg
              >
            </a>
          </li>
          <li>
            <a href={share.x} target="_blank" rel="noopener" aria-label="Share event on X">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.3L5.6 21h-3l7.1-8.1L2.2 3h6.2l4.3 5.7L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"
                ></path></svg
              >
            </a>
          </li>
          <li>
            <a href={share.linkedin} target="_blank" rel="noopener" aria-label="Share event on LinkedIn">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3V9.5zm6.5 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4V9.5z"
                ></path></svg
              >
            </a>
          </li>
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .event__head {
    position: relative;
    background: linear-gradient(var(--mist) 0, var(--mist) calc(100% - 276px), var(--cream) calc(100% - 276px));
    padding: 65px var(--gutter) 0;
  }

  .event__intro {
    max-width: 843px;
    margin-inline: auto;
    text-align: center;
  }

  .event__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(34px, 22px + 2.6vw, 60px);
    line-height: 1.2;
  }

  .event__when {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 25px;
    font-size: 18px;
    line-height: 1.4;
  }

  .event__rule {
    margin: 42px 0 41px;
    border: 0;
    border-top: 1px solid var(--hairline);
  }

  .event__status {
    font-size: 16px;
    line-height: 1.5;
  }

  .event__other {
    font-size: 16px;
    line-height: 1.5;
  }

  .event__image {
    max-width: 979px;
    margin: 60px auto 0;
    background: var(--lime);
  }

  .event__image :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 979 / 552;
    object-fit: cover;
  }

  .event__body {
    display: grid;
    gap: 60px;
    max-width: 843px;
    margin: 50px auto 0;
    padding: 0 var(--gutter) 40px;
    box-sizing: content-box;
    font-size: 16px;
    line-height: 1.5;
  }

  .event__heading {
    margin-bottom: 15px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.3;
  }

  .event__about {
    white-space: pre-line;
  }

  .event__share {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .event__share a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--olive);
    transition: opacity 0.3s ease;
  }

  .event__share a:hover {
    opacity: 0.7;
  }

  @media (max-width: 767.98px) {
    .event__head {
      padding-top: calc(36 * var(--m));
      background: linear-gradient(var(--mist) 0, var(--mist) calc(100% - 25vw), var(--cream) calc(100% - 25vw));
    }

    .event__title {
      font-size: calc(32 * var(--m));
    }

    .event__when {
      margin-top: calc(16 * var(--m));
      font-size: calc(16 * var(--m));
    }

    .event__rule {
      margin: calc(28 * var(--m)) 0;
    }

    .event__image {
      margin-top: calc(36 * var(--m));
      margin-inline: calc(-1 * var(--gutter));
    }

    .event__body {
      gap: calc(40 * var(--m));
      margin-top: calc(36 * var(--m));
      font-size: calc(15 * var(--m));
    }

    .event__heading {
      font-size: calc(24 * var(--m));
    }
  }
</style>
