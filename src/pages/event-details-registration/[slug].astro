---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BookingCta from '../../components/BookingCta.astro';
import RichText from '../../components/RichText.astro';
import { site } from '../../data/site';
import { events, type SiteEvent } from '../../data/events';

export const getStaticPaths = (() =>
  events.map((event) => ({ params: { slug: event.slug }, props: { event } }))) satisfies GetStaticPaths;

interface Props {
  event: SiteEvent;
}

const { event } = Astro.props;
const pageUrl = `${site.url}/event-details-registration/${event.slug}`;
const shareText = 'Check out this event. Hope to see you there!';
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
  x: `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareText)}`,
  linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(pageUrl)}`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.start,
  endDate: event.end,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: event.venue, address: event.address.replace(/^Bedminster, /, '') },
};
---

<BaseLayout title={event.title} description={event.about} image={event.image} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="Workshop"
    title={event.title}
    size="md"
    tone="mist"
    image={event.image}
    imageAlt={event.title}
    imageRatio="16 / 10"
  >
    <ul class="chips" aria-label="When and where">
      <li class="chip">{event.shortDate}</li>
      <li class="chip">{event.venue}</li>
    </ul>
    <p class="status">{event.ticketsOnSale ? 'Tickets on sale' : 'Tickets are not on sale'}</p>
    <Fragment slot="actions">
      <a class="btn btn--outline" href="/">See other events</a>
    </Fragment>
  </PageHeader>

  <section class="section section--cream">
    <div class="container details">
      <div class="details__main">
        <p class="eyebrow">Workshop details</p>
        <h2 class="h2">About the event</h2>
        <div class="details__about">
          <RichText text={event.about} />
        </div>
      </div>

      <aside class="details__card">
        <h2 class="h4">Time &amp; Location</h2>
        <p class="details__when">{event.when}</p>
        <p>{event.address}</p>

        <h2 class="h4 details__share-title">Share this event</h2>
        <ul class="share">
          <li>
            <a href={share.facebook} target="_blank" rel="noopener" aria-label="Share event on Facebook">
              <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z"
                ></path></svg
              >
            </a>
          </li>
          <li>
            <a href={share.x} target="_blank" rel="noopener" aria-label="Share event on X">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.3L5.6 21h-3l7.1-8.1L2.2 3h6.2l4.3 5.7L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"
                ></path></svg
              >
            </a>
          </li>
          <li>
            <a href={share.linkedin} target="_blank" rel="noopener" aria-label="Share event on LinkedIn">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3V9.5zm6.5 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4V9.5z"
                ></path></svg
              >
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <BookingCta tone="lime" />
</BaseLayout>

<style>
  .status {
    margin-top: 18px;
    font-size: var(--text-small);
    font-weight: 400;
  }

  .details {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    align-items: start;
    gap: clamp(36px, 6vw, 96px);
  }

  .details__about {
    margin-top: clamp(20px, 2.5vw, 28px);
  }

  .details__card {
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--sage);
  }

  .details__when {
    margin-top: 14px;
    font-weight: 400;
  }

  .details__share-title {
    margin-top: 32px;
  }

  .share {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }

  .share a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--hairline-strong);
    border-radius: 50%;
    color: var(--olive);
    transition: background-color 0.3s ease;
  }

  .share a:hover {
    background: rgba(var(--olive-rgb), 0.08);
  }

  @media (max-width: 899.98px) {
    .details {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
