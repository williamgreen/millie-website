---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import BookingCta from '../components/BookingCta.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import portrait from '../assets/images/amelia-portrait.jpg';
import portraitDark from '../assets/images/amelia-portrait-black-top.jpg';

// Highlights pulled from "My Story" below.
const credentials = [
  { figure: '3 years', text: 'Studied at the College of Naturopathic Medicine (CNM) in Bristol' },
  { figure: '200+ hours', text: 'Of clinical experience, alongside a diploma in Nutritional Therapy' },
  { figure: 'ANP', text: 'Full member of the Association of Naturopathic Practitioners' },
  { figure: 'CNHC', text: 'Member of the Complementary & Natural Healthcare Council' },
];
---

<BaseLayout title="About">
  <PageHeader
    eyebrow="About"
    title="I am Amelia"
    image={portrait}
    imageAlt="Amelia Peace smiling, wearing a green jumper"
    imagePosition="50% 30%"
  >
    <p>I'm a registered Naturopathic Nutritional Therapist - empowering women’s health through nutrition.</p>
    <Fragment slot="actions">
      <a class="btn" href="/service-page/free-phone-consultation-1">Book a Free Call <Arrow /></a>
      <ul class="social" aria-label="Social links">
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
              <path
                fill="currentColor"
                d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3V9.5zm6.5 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4V9.5z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={site.instagram.url} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"
              ></rect>
              <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
              <circle cx="17.2" cy="6.8" r="1.15" fill="currentColor"></circle>
            </svg>
          </a>
        </li>
      </ul>
    </Fragment>
  </PageHeader>

  <section class="section section--cream" aria-labelledby="approach-title">
    <div class="container approach">
      <div>
        <p class="eyebrow">My approach</p>
        <h2 class="h2" id="approach-title">A holistic approach to women’s health</h2>
      </div>
      <div class="approach__text">
        <p class="lead">
          I prioritise the unique needs of women in all stages of life, from adolescence to menopause and beyond.
        </p>
        <p>
          I believe in a holistic approach to health, focusing not only on physical well-being but also on emotional and
          mental health. I use evidence-based nutritional science to get to the root cause of your health symptoms, both
          short and long term.
        </p>
        <p>I see clients online through zoom as well as 1:1 in Bristol, where I'm based.</p>
        <ul class="chips" aria-label="Where I see clients">
          <li class="chip">Online via Zoom</li>
          <li class="chip">1:1 in Bristol</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="story-title">
    <div class="container story">
      <div class="story__head">
        <p class="eyebrow">Background</p>
        <h2 class="h2" id="story-title">My Story</h2>
      </div>
      <div class="prose story__text">
        <p class="lead">
          My interest in women's health was ignited by the understanding of the unique challenges women face throughout
          their lives.
        </p>
        <p>
          My journey into this field began with a commitment to empower women to take control of their well-being. Over
          the years, I've witnessed the transformative power of personalised care and education, and it has become the
          cornerstone of my practice.
        </p>
        <p>
          I studied for three years at the renowned College of Naturopathic medicine (CNM) in Bristol and qualified as a
          registered nutritionist with a diploma in Nutritional Therapy; completing a foundation year in Biomedicine and
          Human Sciences alongside over 200 hours of clinical experience.
        </p>
        <p>
          I am a full member of the Association of Naturopathic Practitioners and am required to attend undergraduate and
          postgraduate training on an ongoing basis — maintaining my knowledge and continually growing my passion for
          nutritional therapy. As well as this I am also a member of the Complementary &amp; Natural Healthcare Council
          (CNHC). My practice is insured through Balens.
        </p>
        <p>
          Within my practice I use nutrition to promote the body's own self-healing mechanisms. Food is meant to be enjoyed
          and I want to help you get to a place where the food you love, loves you back. We’ll work together to get to the
          root of your symptoms and help you not only to feel better, but to achieve the best possible physical, emotional
          and mental state.
        </p>
        <p>I offer a food first approach, with supplements and lifestyle recommendations where necessary.</p>
      </div>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="credentials-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Training &amp; registration</p>
        <h2 class="h2" id="credentials-title">Qualified, registered and insured</h2>
      </div>
      <ul class="credentials">
        {
          credentials.map((item) => (
            <li class="credentials__item">
              <span class="credentials__figure">{item.figure}</span>
              <span class="credentials__text">{item.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookingCta
    tone="lime"
    image={portraitDark}
    imageAlt="Amelia Peace in a black top, smiling"
    imagePosition="50% 25%"
  />
</BaseLayout>

<style>
  /* Social icons next to the header button */
  .social {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0 0 0 6px;
    padding: 0;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--hairline-strong);
    border-radius: 50%;
    color: var(--olive);
    transition: background-color 0.3s ease;
  }

  .social a:hover {
    background: rgba(var(--olive-rgb), 0.08);
  }

  /* My approach */
  .approach {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
  }

  .approach__text {
    max-width: 60ch;
  }

  .approach__text > * + * {
    margin-top: 1em;
  }

  .approach__text .chips {
    margin-top: 28px;
  }

  /* My story */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(32px, 6vw, 96px);
  }

  .story__head {
    align-self: start;
    position: sticky;
    top: 32px;
  }

  /* Credentials */
  .credentials {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .credentials__item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--sage);
  }

  /* Sized so even "200+ hours" stays on one line and the four descriptions line up. */
  .credentials__figure {
    font-family: var(--font-serif);
    font-size: clamp(30px, 6px + 2.6vw, 46px);
    line-height: 1;
    white-space: nowrap;
  }

  .credentials__text {
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (max-width: 1023.98px) {
    .credentials {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899.98px) {
    .approach,
    .story {
      grid-template-columns: minmax(0, 1fr);
    }

    .story__head {
      position: static;
    }
  }

  @media (max-width: 479.98px) {
    .credentials {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
