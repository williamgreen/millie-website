---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsultSplit from '../components/ConsultSplit.astro';
import { site } from '../data/site';
import portrait from '../assets/images/amelia-portrait.jpg';
import linkedinIcon from '../assets/images/social-linkedin.png';
import instagramIcon from '../assets/images/social-instagram.png';
---

<BaseLayout title="About">
  <section class="intro" aria-labelledby="about-title">
    <h1 class="visually-hidden" id="about-title">About</h1>
    <div class="intro__inner">
      <div class="intro__media">
        <Image
          src={portrait}
          alt="Amelia Peace smiling, wearing a green jumper"
          widths={[320, 480, 640, 916]}
          sizes="(min-width: 768px) 458px, calc(100vw - 40px)"
          loading="eager"
        />
      </div>
      <div class="intro__body">
        <div class="intro__text rich">
          <p>
            I am Amelia, I'm a registered Naturopathic Nutritional Therapist - empowering women’s health through
            nutrition.
          </p>
          <p></p>
          <p>
            I prioritise the unique needs of women in all stages of life, from adolescence to menopause and beyond. I
            believe in a holistic approach to health, focusing not only on physical well-being but also on emotional and
            mental health. I use evidence-based nutritional science to get to the root cause of your health symptoms,
            both short and long term.
          </p>
          <p></p>
          <p>I see clients online through zoom as well as 1:1 in Bristol, where I'm based.</p>
        </div>
        <ul class="social" aria-label="Social links">
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener">
              <Image src={linkedinIcon} alt="LinkedIn" width={24} height={24} densities={[1, 2, 3]} />
            </a>
          </li>
          <li>
            <a href={site.instagram.url} target="_blank" rel="noopener">
              <Image src={instagramIcon} alt="Instagram" width={24} height={24} densities={[1, 2, 3]} />
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="story" aria-labelledby="story-title">
    <div class="story__inner">
      <h2 class="story__title" id="story-title">My Story</h2>
      <div class="story__text rich">
        <p>
          My interest in women's health was ignited by the understanding of the unique challenges women face throughout
          their lives. My journey into this field began with a commitment to empower women to take control of their
          well-being. Over the years, I've witnessed the transformative power of personalised care and education, and it
          has become the cornerstone of my practice.
        </p>
        <p></p>
        <p>
          I studied for three years at the renowned College of Naturopathic medicine (CNM) in Bristol and qualified as a
          registered nutritionist with a diploma in Nutritional Therapy; completing a foundation year in Biomedicine and
          Human Sciences alongside over 200 hours of clinical experience.
        </p>
        <p></p>
        <p>
          I am a full member of the Association of Naturopathic Practitioners and am required to attend undergraduate
          and postgraduate training on an ongoing basis — maintaining my knowledge and continually growing my passion for
          nutritional therapy. As well as this I am also a member of the Complementary &amp; Natural Healthcare Council
          (CNHC). My practice is insured through Balens.
        </p>
        <p></p>
        <p>
          Within my practice I use nutrition to promote the body's own self-healing mechanisms. Food is meant to be
          enjoyed and I want to help you get to a place where the food you love, loves you back. We’ll work together to
          get to the root of your symptoms and help you not only to feel better, but to achieve the best possible
          physical, emotional and mental state.
        </p>
        <p></p>
        <p>I offer a food first approach, with supplements and lifestyle recommendations where necessary.</p>
      </div>
    </div>
  </section>

  <ConsultSplit size="md" />
</BaseLayout>

<style>
  /* ---------- Intro ---------- */
  .intro {
    background: var(--sage);
    padding: 45px var(--gutter) 10px;
  }

  .intro__inner {
    display: grid;
    grid-template-columns: minmax(0, 458px) minmax(0, 592px);
    justify-content: center;
    gap: 41px;
  }

  .intro__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 458 / 476;
    object-fit: cover;
  }

  .intro__body {
    padding-top: 11px;
  }

  .intro__text {
    font-size: 20px;
    line-height: 1.2;
  }

  .social {
    display: flex;
    gap: 7px;
    list-style: none;
    margin: 42px 0 0;
    padding: 0;
  }

  .social a {
    display: block;
    transition: opacity 0.3s ease;
  }

  .social a:hover {
    opacity: 0.7;
  }

  .social :global(img) {
    width: 24px;
    height: 24px;
  }

  /* ---------- My Story ---------- */
  .story {
    padding: 68px var(--gutter) 40px;
  }

  .story__inner {
    max-width: 980px;
    margin-inline: auto;
  }

  .story__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 38px;
    line-height: 1.1;
  }

  .story__text {
    margin-top: 28px;
    font-size: 20px;
    line-height: 1.2;
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1023.98px) {
    .intro {
      padding-top: 40px;
      padding-bottom: 40px;
    }

    .intro__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      gap: 32px;
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 767.98px) {
    .intro {
      padding: 0 calc(20 * var(--m)) calc(20 * var(--m));
    }

    .intro__inner {
      grid-template-columns: 1fr;
      gap: calc(20 * var(--m));
    }

    .intro__media :global(img) {
      aspect-ratio: 280 / 291;
    }

    .intro__body {
      padding-top: 0;
    }

    .intro__text {
      font-size: calc(20 * var(--m));
    }

    .social {
      justify-content: center;
      margin-top: calc(60 * var(--m));
    }

    .social :global(img) {
      width: calc(24 * var(--m));
      height: calc(24 * var(--m));
    }

    .story {
      padding: calc(47 * var(--m)) calc(20 * var(--m)) calc(40 * var(--m));
    }

    .story__title {
      font-size: calc(30 * var(--m));
    }

    .story__text {
      margin-top: calc(20 * var(--m));
      font-size: calc(20 * var(--m));
    }
  }
</style>
