---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import supperClub from '../assets/images/supper-club.jpg';
import garden from '../assets/images/amelia-garden.jpg';
---

<BaseLayout title="1:1 Serives">
  <section class="intro">
    <h1 class="intro__title">Packages</h1>
    <p class="intro__text">
      Rather than a 'one size fits all approach' I consider each individual to be unique and recommend personalised
      nutrition and lifestyle programmes to best help your symptoms.
    </p>
  </section>

  <section class="pkg" aria-labelledby="pkg-foundation">
    <div class="pkg__media">
      <Image
        src={supperClub}
        alt="Guests seated along a long table at a candlelit supper club"
        widths={[480, 720, 960, 1440]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
      />
    </div>
    <div class="pkg__body">
      <h2 class="pkg__title" id="pkg-foundation"><a href="/book-online">3 Month Foundation Package</a></h2>
      <div class="pkg__text rich">
        <p>Individuals looking to establish healthy habits and gain clarity on their nutritional needs.</p>
        <p></p>
        <ul>
          <li>Initial Consultation: 90 minutes</li>
          <li>Follow-Up Sessions: 2 x 45 minutes</li>
          <li>Duration: 3 Months</li>
          <li>Support: Email access between sessions</li>
          <li>Cost: £350</li>
        </ul>
        <p></p>
        <p></p>
        <p>
          This package provides foundational support and guidance, helping you make sustainable improvements in your
          diet and lifestyle.
        </p>
      </div>
      <a class="btn" href="/book-online">Book Here</a>
    </div>
  </section>

  <section class="pkg pkg--reverse" aria-labelledby="pkg-transformation">
    <div class="pkg__body">
      <h2 class="pkg__title" id="pkg-transformation"><a href="/book-online">Transformation Package</a></h2>
      <div class="pkg__text rich">
        <p>Ideal for: Clients seeking more comprehensive support to address specific health goals or challenges.</p>
        <p></p>
        <ul>
          <li>Initial Consultation: 90 minutes</li>
          <li>Follow-Up Sessions: 4 x 45 minutes</li>
          <li>Duration: Approximately 5</li>
          <li>Support: Email and messaging support during clinic hours</li>
          <li>Cost: £500</li>
        </ul>
        <p></p>
        <p>
          This package offers more in-depth support, allowing for personalised strategies and adjustments over a longer
          period to achieve meaningful health changes.
        </p>
      </div>
      <a class="btn" href="/book-online">Book Here</a>
    </div>
    <div class="pkg__media">
      <Image
        src={garden}
        alt="Amelia standing in front of a red Japanese maple"
        widths={[480, 720, 960, 1440]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Intro ---------- */
  .intro {
    padding: 23px var(--gutter) 38px;
    text-align: center;
  }

  .intro__title {
    font-size: clamp(34px, 20px + 2.6vw, 56px);
    line-height: 1.18;
  }

  .intro__text {
    max-width: 605px;
    margin: 14px auto 0;
    font-size: 20px;
    line-height: 1.2;
  }

  /* ---------- Packages ---------- */
  /* 1px olive frame lines between and around the columns, as on the original. */
  .pkg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    padding: 1px;
    background: var(--olive);
  }

  .pkg__media {
    position: relative;
    min-height: 300px;
    overflow: hidden;
    background: var(--sage);
  }

  .pkg__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pkg__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 88px 24px 126px;
    background: var(--cream);
  }

  .pkg--reverse .pkg__body {
    padding-top: 70px;
    padding-bottom: 68px;
  }

  .pkg__title {
    max-width: 404px;
    font-size: clamp(30px, 23px + 1.1vw, 38px);
    line-height: 1.2;
    text-align: center;
  }

  .pkg__title a {
    text-decoration: none;
  }

  .pkg:not(.pkg--reverse) .pkg__title {
    max-width: 350px;
  }

  .pkg__text {
    width: min(100%, 365px);
    margin-top: 24px;
    font-size: 20px;
    line-height: 1.2;
  }

  .pkg--reverse .pkg__text {
    margin-top: 50px;
  }

  .pkg__text ul {
    padding-left: 32px;
  }

  .pkg__text li {
    padding-left: 4px;
  }

  .pkg .btn {
    margin-top: 40px;
  }

  .pkg--reverse .btn {
    margin-top: 64px;
  }

  /* ---------- Mobile: image on top of each package ---------- */
  @media (max-width: 767.98px) {
    .intro {
      padding: calc(40 * var(--m)) calc(38 * var(--m)) calc(62 * var(--m));
    }

    .intro__title {
      font-size: calc(30 * var(--m));
    }

    .intro__text {
      margin-top: calc(20 * var(--m));
      font-size: calc(18 * var(--m));
    }

    .pkg {
      grid-template-columns: 1fr;
      padding: 0;
      padding-top: 1px;
    }

    .pkg__media {
      order: -1;
      min-height: 0;
      aspect-ratio: 320 / 240;
    }

    .pkg__body,
    .pkg--reverse .pkg__body {
      padding: calc(41 * var(--m)) calc(24 * var(--m)) calc(20 * var(--m));
    }

    .pkg__title,
    .pkg:not(.pkg--reverse) .pkg__title {
      max-width: calc(220 * var(--m));
      font-size: calc(22 * var(--m));
    }

    .pkg__text,
    .pkg--reverse .pkg__text {
      width: 100%;
      margin-top: calc(21 * var(--m));
      font-size: calc(20 * var(--m));
    }

    .pkg .btn,
    .pkg--reverse .btn {
      margin-top: calc(20 * var(--m));
    }
  }
</style>
