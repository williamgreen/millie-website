---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import BookingCta from '../components/BookingCta.astro';
import Arrow from '../components/Arrow.astro';
import supperClub from '../assets/images/supper-club.jpg';
import garden from '../assets/images/amelia-garden.jpg';
import plates from '../assets/images/service-diet-lifestyle-analysis.jpg';
import freeCall from '../assets/images/service-free-phone-consultation.jpg';

const packages = [
  {
    id: 'foundation',
    name: '3 Month Foundation Package',
    price: '£350',
    intro: 'Individuals looking to establish healthy habits and gain clarity on their nutritional needs.',
    features: [
      'Initial Consultation: 90 minutes',
      'Follow-Up Sessions: 2 x 45 minutes',
      'Duration: 3 Months',
      'Support: Email access between sessions',
    ],
    outro:
      'This package provides foundational support and guidance, helping you make sustainable improvements in your diet and lifestyle.',
    image: supperClub,
    imageAlt: 'Guests seated along a long table at a candlelit supper club',
    imagePosition: '50% 55%',
  },
  {
    id: 'transformation',
    name: 'Transformation Package',
    price: '£500',
    intro: 'Ideal for: Clients seeking more comprehensive support to address specific health goals or challenges.',
    features: [
      'Initial Consultation: 90 minutes',
      'Follow-Up Sessions: 4 x 45 minutes',
      'Duration: Approximately 5',
      'Support: Email and messaging support during clinic hours',
    ],
    outro:
      'This package offers more in-depth support, allowing for personalised strategies and adjustments over a longer period to achieve meaningful health changes.',
    image: garden,
    imageAlt: 'Amelia standing in front of a red Japanese maple',
    imagePosition: '50% 30%',
  },
];
---

<BaseLayout title="1:1 Serives">
  <PageHeader eyebrow="1:1 services" title="Packages">
    <p>
      Rather than a 'one size fits all approach' I consider each individual to be unique and recommend personalised
      nutrition and lifestyle programmes to best help your symptoms.
    </p>
  </PageHeader>

  <section class="section section--cream" aria-label="Packages">
    <div class="container packages">
      {
        packages.map((pkg) => (
          <article class="package" aria-labelledby={`pkg-${pkg.id}`}>
            <div class="package__media">
              <Image
                src={pkg.image}
                alt={pkg.imageAlt}
                widths={[480, 720, 960, 1280]}
                sizes="(min-width: 900px) 46vw, 100vw"
                class="media-cover"
                style={`object-position: ${pkg.imagePosition}`}
              />
            </div>
            <div class="package__body">
              <h2 class="h3" id={`pkg-${pkg.id}`}>
                {pkg.name}
              </h2>
              <p class="package__price">
                <span>{pkg.price}</span>
              </p>
              <p class="package__intro">{pkg.intro}</p>
              <ul class="ticks package__features">
                {pkg.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <p class="package__outro">{pkg.outro}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="container mini">
      <div class="mini__card">
        <div class="mini__media">
          <Image
            src={plates}
            alt="Plates of colourful food being shared at a table"
            widths={[320, 480, 640]}
            sizes="(min-width: 900px) 220px, 100vw"
            class="media-cover"
          />
        </div>
        <div class="mini__text">
          <p class="eyebrow">Not ready for a full programme?</p>
          <h2 class="h3">Diet &amp; Lifestyle Analysis</h2>
          <p>A focused mini consultation — £75, one-time session.</p>
        </div>
        <a class="btn btn--outline mini__cta" href="/about-6">Find out more <Arrow /></a>
      </div>
    </div>
  </section>

  <BookingCta
    tone="sage"
    image={freeCall}
    imageAlt="Heirloom tomatoes in a market crate"
    secondaryLabel="How I work"
    secondaryHref="/team-3"
  />
</BaseLayout>

<style>
  .packages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .package {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--sage);
  }

  .package__media {
    aspect-ratio: 16 / 11;
    min-height: 0;
    overflow: hidden;
  }

  .package__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(28px, 4vw, 48px);
  }

  .package__price {
    margin-top: 14px;
    font-family: var(--font-serif);
    font-size: clamp(44px, 34px + 2vw, 64px);
    line-height: 1;
  }

  .package__intro {
    margin-top: 20px;
    font-size: var(--text-lead);
    line-height: 1.45;
  }

  .package__features {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
  }

  .package__outro {
    margin-top: 24px;
  }

  /* Diet & Lifestyle Analysis teaser */
  .mini {
    margin-top: clamp(20px, 3vw, 40px);
  }

  .mini__card {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    padding: 16px clamp(16px, 3vw, 40px) 16px 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
  }

  .mini__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .mini__text .eyebrow {
    margin-bottom: 10px;
  }

  .mini__text p:last-child {
    margin-top: 8px;
  }

  @media (max-width: 899.98px) {
    .packages {
      grid-template-columns: minmax(0, 1fr);
    }

    .mini__card {
      grid-template-columns: minmax(0, 1fr);
      padding: 16px 16px 24px;
    }

    .mini__cta {
      justify-self: start;
    }
  }
</style>
