---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" index={false}>
  <section class="not-found">
    <h1>Page not found</h1>
    <p>Sorry, the page you’re looking for doesn’t exist or has moved.</p>
    <a class="btn" href="/">Back to home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 120px var(--gutter) 140px;
    background: var(--sage);
    text-align: center;
  }

  h1 {
    font-size: clamp(34px, 20px + 2.6vw, 56px);
    line-height: 1.2;
  }

  p {
    max-width: 560px;
    font-size: 20px;
    line-height: 1.4;
  }
</style>
