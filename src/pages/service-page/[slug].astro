---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { services, spokenDuration, type Service } from '../../data/services';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<BaseLayout title={service.name} description={service.description} image={service.image}>
  <article class="service">
    <header class="service__head">
      <h1 class="service__title">{service.name}</h1>
      <p class="service__tagline">{service.tagline}</p>
      <ul class="service__details" aria-label="Details">
        <li aria-label={spokenDuration(service.duration)}>{service.duration}</li>
        {service.price && <li>{service.price}</li>}
        <li>{site.address.venue}</li>
      </ul>
      <a class="btn-book service__book" href={service.bookingUrl}>Book Now</a>
    </header>

    {
      service.description && (
        <section class="service__section" aria-labelledby="description-title">
          <h2 class="service__heading" id="description-title">
            Service Description
          </h2>
          <p class="service__description">{service.description}</p>
        </section>
      )
    }

    <section class="service__section" aria-labelledby="contact-title">
      <h2 class="service__heading" id="contact-title">Contact Details</h2>
      <p>{site.address.full}</p>
      <p><a href={`tel:+44${site.phone.slice(1)}`}>{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </section>
  </article>
</BaseLayout>

<style>
  .service {
    width: min(100% - 2 * var(--gutter), 720px);
    margin: 0 auto;
    padding: 72px 0 40px;
    font-size: 16px;
    line-height: 1.5;
  }

  .service__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.4;
  }

  .service__tagline {
    margin-top: 16px;
  }

  .service__details {
    display: inline-flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    border: 1px solid var(--hairline);
  }

  .service__details li {
    padding: 16px 16px;
  }

  .service__details li + li {
    border-left: 1px solid var(--hairline);
  }

  .service__head {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--hairline);
  }

  .service__book {
    display: flex;
    width: fit-content;
    min-width: 132px;
    margin-top: 32px;
  }

  .service__section {
    padding: 32px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .service__heading {
    margin-bottom: 16px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.4;
  }

  .service__description {
    white-space: pre-line;
  }

  .service__section a {
    text-decoration: none;
  }

  .service__section a:hover {
    text-decoration: underline;
  }

  @media (max-width: 767.98px) {
    .service {
      padding-top: calc(36 * var(--m));
      font-size: calc(15 * var(--m));
    }

    .service__title {
      font-size: calc(32 * var(--m));
      line-height: 1.3;
    }

    .service__tagline {
      margin-top: calc(14 * var(--m));
    }

    .service__details {
      margin-top: calc(28 * var(--m));
    }

    .service__details li {
      padding: calc(14 * var(--m)) calc(16 * var(--m));
    }

    .service__heading {
      font-size: calc(20 * var(--m));
    }
  }
</style>
