---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BookingCta from '../../components/BookingCta.astro';
import RichText from '../../components/RichText.astro';
import EmailText from '../../components/EmailText.astro';
import Arrow from '../../components/Arrow.astro';
import { site } from '../../data/site';
import { services, spokenDuration, type Service } from '../../data/services';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
// The Diet & Lifestyle Analysis has its own page with the full description.
const moreInfo = service.slug === 'diet-lifestyle-analysis' ? '/about-6' : undefined;
---

<BaseLayout title={service.name} description={service.description} image={service.image}>
  <PageHeader
    eyebrow={service.tagline}
    title={service.name}
    size="md"
    image={service.image}
    imageAlt={service.imageAlt}
    imageRatio="4 / 3"
  >
    <ul class="chips" aria-label="Details">
      <li class="chip" aria-label={spokenDuration(service.duration)}>{service.duration}</li>
      <li class="chip">{service.price ?? 'Free'}</li>
      <li class="chip">{site.address.venue}</li>
    </ul>
    <Fragment slot="actions">
      <a class="btn" href={service.bookingUrl}>Book Now <Arrow /></a>
      <a class="btn btn--outline" href="/general-1">See packages</a>
    </Fragment>
  </PageHeader>

  <section class="section section--cream">
    <div class="container details">
      <div class="details__main">
        {
          service.description ? (
            <>
              <p class="eyebrow">About this service</p>
              <h2 class="h2">Service Description</h2>
              <div class="details__description">
                <RichText text={service.description} />
              </div>
            </>
          ) : (
            <>
              <p class="eyebrow">About this service</p>
              <h2 class="h2">{service.tagline}</h2>
              {moreInfo && (
                <a class="btn btn--outline details__more" href={moreInfo}>
                  Read the full details <Arrow />
                </a>
              )}
            </>
          )
        }
      </div>

      <aside class="details__card" aria-labelledby="summary-title">
        <h2 class="h4" id="summary-title">At a glance</h2>
        <dl class="summary">
          <div>
            <dt>Appointment</dt>
            <dd aria-label={spokenDuration(service.duration)}>{service.duration}</dd>
          </div>
          <div>
            <dt>Price</dt>
            <dd>{service.price ?? 'Free'}</dd>
          </div>
        </dl>
        <a class="btn btn--block" href={service.bookingUrl}>Book Now <Arrow /></a>

        <h2 class="h4 details__contact-title">Contact Details</h2>
        <ul class="details__contact">
          <li>{site.address.full}</li>
          <li><a href={`tel:+44${site.phone.slice(1)}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}><EmailText /></a></li>
        </ul>
      </aside>
    </div>
  </section>

  {service.slug !== 'free-phone-consultation-1' && <BookingCta tone="lime" />}
</BaseLayout>

<style>
  .details {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    align-items: start;
    gap: clamp(36px, 6vw, 96px);
  }

  .details__description {
    margin-top: clamp(20px, 2.5vw, 28px);
  }

  .details__more {
    margin-top: 28px;
  }

  .details__card {
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--sage);
  }

  /*
   * The label column is as wide as the longest label (in whatever font the device
   * uses), and every row shares it through subgrid, so the values line up and a
   * label can never run into its value.
   */
  .summary {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 14px 20px;
    margin: 20px 0 28px;
  }

  .summary div {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    row-gap: 2px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
  }

  .summary dt {
    font-weight: 400;
    font-size: var(--text-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--olive-soft);
  }

  .summary dd {
    margin: 0;
  }

  .details__contact-title {
    margin-top: 32px;
  }

  .details__contact {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    font-size: var(--text-small);
  }

  .details__contact a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .details__contact a:hover {
    text-decoration: underline;
  }

  /* Keep the card in view while reading, on screens tall enough to show all of it. */
  @media (min-width: 900px) and (min-height: 760px) {
    .details__card {
      position: sticky;
      top: 32px;
    }
  }

  @media (max-width: 899.98px) {
    .details {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
