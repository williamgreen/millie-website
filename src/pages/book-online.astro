---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Arrow from '../components/Arrow.astro';
import { services, spokenDuration } from '../data/services';
---

<BaseLayout title="Book Online">
  <PageHeader eyebrow="Book online" title="My Services" />

  <section class="section section--cream" aria-label="Services">
    <div class="container">
      <ul class="services">
        {
          services.map((service, i) => (
            <li class="service">
              <a class="service__media" href={`/service-page/${service.slug}`} tabindex="-1" aria-hidden="true">
                <Image
                  src={service.image}
                  alt=""
                  widths={[400, 600, 800, 1100]}
                  sizes="(min-width: 1100px) 40vw, (min-width: 700px) 46vw, 100vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  class="media-cover"
                />
              </a>
              <div class="service__body">
                <p class="eyebrow service__tagline">{service.tagline}</p>
                <h2 class="h3 service__name">
                  <a href={`/service-page/${service.slug}`}>{service.name}</a>
                </h2>
                <ul class="chips service__meta" aria-label="Details">
                  <li class="chip" aria-label={spokenDuration(service.duration)}>
                    {service.duration}
                  </li>
                  <li class="chip">{service.price ?? 'Free'}</li>
                </ul>
                <div class="btn-row service__actions">
                  <a class="btn btn--sm" href={service.bookingUrl}>
                    Book Now<span class="visually-hidden">: {service.name}</span> <Arrow size={18} />
                  </a>
                  <a class="btn btn--sm btn--outline" href={`/service-page/${service.slug}`}>
                    Details<span class="visually-hidden">: {service.name}</span>
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--sage);
  }

  .service__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .service__media :global(img) {
    transition: transform 0.6s ease;
  }

  .service__media:hover :global(img) {
    transform: scale(1.03);
  }

  .service__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(24px, 3.5vw, 40px);
  }

  .service__tagline {
    margin-bottom: 12px;
  }

  .service__name a {
    text-decoration: none;
  }

  .service__name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .service__meta {
    margin-top: 20px;
  }

  .service__actions {
    margin-top: auto;
    padding-top: 28px;
  }

  @media (max-width: 699.98px) {
    .services {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
