---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import BookingCta from '../components/BookingCta.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import readingMenu from '../assets/images/amelia-reading-menu.jpg';
import greengrocer from '../assets/images/amelia-greengrocer.jpg';

const jsonLd = [
  {
    '@context': 'https://schema.org/',
    '@type': 'LocalBusiness',
    name: site.name,
    url: site.url,
    email: site.email,
    telephone: '+447867122963',
    address: {
      '@type': 'PostalAddress',
      addressCountry: site.address.country,
      addressLocality: site.address.locality,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      streetAddress: site.address.street,
    },
    sameAs: [site.instagram.url, site.linkedin],
  },
  { '@context': 'https://schema.org/', '@type': 'WebSite', name: site.titleSuffix, url: site.url },
];

const stories = [
  {
    name: 'Leah',
    text: 'Working with Amelia for my nutritional therapy consultation has been a truly transformative experience. She combines deep expertise with a compassionate, personalised approach that makes you feel truly cared for. Amelia takes the time to understand your unique needs and goals, and her recommendations are both practical and life-changing. Thanks to her guidance, I now feel more energized, balanced, and empowered to make healthier choices every day.',
  },
  {
    name: 'Esme',
    text: "From the very first session, Amelia's warmth, knowledge, and genuine care for my well-being put me at ease. She took the time to truly listen to my concerns, tailoring her approach to my unique health needs. Her guidance not only helped me understand how to nourish my body better but also inspired me to make sustainable, long-term changes.",
  },
];
---

<BaseLayout
  fullTitle="Amelia Peace Nutrition | Nutritional Therapy"
  description={site.description}
  jsonLd={jsonLd}
  overlayHeader
>
  <HomeHero />

  <section class="section section--cream mission" id="mission" aria-labelledby="mission-title">
    <div class="container mission__inner">
      <div class="mission__media rounded">
        <Image
          src={readingMenu}
          alt="Amelia reading a menu at a restaurant table"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 900px) 42vw, 100vw"
          class="media-cover"
          style="object-position: 50% 12%"
        />
      </div>
      <div class="mission__text">
        <p class="eyebrow">My mission</p>
        <h2 class="h2" id="mission-title">Empowering women to make informed health choices</h2>
        <p class="lead mission__lead">
          My mission is to empower women to make informed health choices when it comes to their nutrition.
        </p>
        <p class="mission__body">
          I aim to break down the barriers to understanding and implementing diet and lifestyle changes, making it
          accessible and achievable for everyone. With science-backed strategies and a compassionate approach, I offer
          practical advice and support to make healthy eating an effortless part of your lifestyle. Whether you’re
          looking to increase energy, balance your hormones, improve gut health, or boost your mental clarity, I'm here
          to guide you every step of the way. You can heal naturally, starting with what's on your plate.
        </p>
        <a class="btn btn--outline mission__cta" href="/about-5">Discover More <Arrow /></a>
      </div>
    </div>
  </section>

  <BookingCta tone="sage" image={greengrocer} reverse />

  <section class="section section--lime stories" aria-labelledby="stories-title">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow stories__eyebrow">Client stories</p>
        <h2 class="h2" id="stories-title">“I’d highly recommend Amelia’s service”</h2>
      </div>
      <div class="stories__grid">
        {
          stories.map((story) => (
            <figure class="story">
              <span class="story__mark" aria-hidden="true">
                “
              </span>
              <blockquote class="story__text">
                <p>{story.text}</p>
              </blockquote>
              <figcaption class="story__name">{story.name}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <InstagramFeed />
</BaseLayout>

<style>
  /* ---------- Mission ---------- */
  .mission__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(40px, 7vw, 112px);
  }

  .mission__media {
    aspect-ratio: 4 / 5;
    max-height: 760px;
  }

  .mission__lead {
    margin-top: clamp(20px, 2.5vw, 28px);
  }

  .mission__body {
    max-width: 60ch;
    margin-top: 16px;
  }

  .mission__cta {
    margin-top: clamp(28px, 3.5vw, 40px);
  }

  /* ---------- Client stories ---------- */
  .stories__eyebrow {
    color: var(--olive);
  }

  .stories__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .story {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: clamp(28px, 4vw, 56px);
    border-radius: var(--radius-lg);
    background: var(--cream);
  }

  .story__mark {
    display: block;
    height: 0.62em;
    font-family: var(--font-serif);
    font-size: clamp(72px, 7vw, 104px);
    line-height: 1;
    color: var(--olive-soft);
  }

  .story__text {
    margin-top: 20px;
    font-size: var(--text-lead);
    line-height: 1.5;
  }

  .story__name {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 28px;
    font-family: var(--font-serif);
    font-size: var(--text-h4);
  }

  .story__name::before {
    content: '';
    width: 36px;
    height: 1px;
    background: currentColor;
  }

  @media (max-width: 899.98px) {
    .mission__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .mission__media {
      aspect-ratio: 4 / 3;
    }

    .stories__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
