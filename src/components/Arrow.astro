---
/** Right arrow used in call-to-action buttons. Decorative. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
  <path
    d="M4 12h15m-6-6 6 6-6 6"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
