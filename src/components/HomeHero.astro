---
/**
 * Full-screen home page hero: a slow crossfading slideshow of the food
 * photography (the frames of the original Wix hero animation) with the
 * headline and call to action overlaid.
 *
 * Slides live in src/assets/images/hero/:
 *   frame-NN.jpg           wide collage, used on landscape screens
 *   frame-NN-portrait.jpg  single photo, used on portrait screens (phones)
 * Add, remove or reorder files there and the slideshow follows.
 *
 * Only the first photo loads with the page. Once the page has loaded, the
 * script fetches each next photo while the current one is showing and fades
 * it in when it is ready, so slow connections never see half-loaded photos.
 * Without JavaScript, or for visitors who prefer less motion, the first photo
 * stays as a still.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Arrow from './Arrow.astro';

type ImageModule = { default: ImageMetadata };
const wideFiles = import.meta.glob<ImageModule>('../assets/images/hero/frame-*.jpg', { eager: true });
const portraitFiles = import.meta.glob<ImageModule>('../assets/images/hero/frame-*-portrait.jpg', { eager: true });

const widePaths = Object.keys(wideFiles)
  .filter((path) => !path.endsWith('-portrait.jpg'))
  .sort();

const slides = await Promise.all(
  widePaths.map(async (path) => {
    const wide = wideFiles[path].default;
    const portrait = portraitFiles[path.replace(/\.jpg$/, '-portrait.jpg')]?.default ?? wide;
    const [wideImg, portraitImg] = await Promise.all([
      getImage({ src: wide, widths: [960, 1440, 1920], format: 'webp', quality: 78 }),
      getImage({ src: portrait, widths: [480, 720, 960], format: 'webp', quality: 78 }),
    ]);
    return { wideImg, portraitImg };
  }),
);

// Slideshow timing: each photo is on screen for STEP seconds, the last FADE of
// which is the crossfade into the next one.
const STEP = 3.2;
const FADE = 1.1;
---

<section
  class="hero"
  aria-labelledby="hero-title"
  data-hero
  data-step={Math.round(STEP * 1000)}
  data-fade={Math.round(FADE * 1000)}
>
  <div class="hero__media" aria-hidden="true">
    {
      slides.map(({ wideImg, portraitImg }, i) => (
        <picture class:list={['hero__slide', { 'is-current': i === 0 }]}>
          <source media="(max-aspect-ratio: 1/1)" srcset={portraitImg.srcSet.attribute} sizes="150vw" />
          <img
            src={wideImg.src}
            srcset={wideImg.srcSet.attribute}
            sizes="100vw"
            alt=""
            width="1920"
            height="1080"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding="async"
          />
        </picture>
      ))
    }
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__text">
      <p class="hero__eyebrow">Registered Naturopathic Nutritional Therapist</p>
      <h1 class="hero__title" id="hero-title">Nutrition for women</h1>
      <p class="hero__lead">Evidence-based, food-first support for every stage of life.</p>
      <div class="hero__actions">
        <a class="btn btn--lg hero__cta" href="/service-page/free-phone-consultation-1">
          Book a Free Call <Arrow size={22} />
        </a>
        <a class="btn btn--lg btn--light hero__secondary" href="/about-5">Discover More</a>
      </div>
      <p class="hero__note">Free 20 minute phone consultation · Online or 1:1 in Bristol</p>
    </div>
  </div>

  {
    slides.length > 1 && (
      <button class="hero__pause" type="button" aria-pressed="false" data-hero-pause hidden>
        <span class="visually-hidden">Pause background slideshow</span>
        <svg class="hero__icon-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
        <svg class="hero__icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor" />
        </svg>
      </button>
    )
  }
</section>

<script>
  // Attributes that make a slide's <picture> download a photo. Slides that are not on
  // screen or next in line keep them in data-* attributes instead, so the browser
  // doesn't fetch every photo again when the screen rotates.
  const URL_ATTRS: [string, string[]][] = [
    ['source', ['srcset']],
    ['img', ['srcset', 'src']],
  ];

  const moveUrls = (slide: HTMLElement, from: string, to: string) => {
    for (const [selector, names] of URL_ATTRS) {
      const el = slide.querySelector(selector);
      if (!el) continue;
      for (const name of names) {
        const value = el.getAttribute(from + name);
        if (value === null) continue;
        el.setAttribute(to + name, value);
        el.removeAttribute(from + name);
      }
    }
  };

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('.hero__slide')];
    const button = hero.querySelector<HTMLButtonElement>('[data-hero-pause]');
    if (slides.length < 2 || !button) return;

    const step = Number(hero.dataset.step);
    const fade = Number(hero.dataset.fade);
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const failed = new Set<number>();
    let current = 0;
    let next = -1;
    let nextReady: Promise<boolean> = Promise.resolve(false);
    let timer: number | undefined;
    let started = false;
    let busy = false;
    let paused = false;
    let inView = true;

    const canRun = () => started && !motion.matches && !paused && inView && !document.hidden && next >= 0;
    // The pause button only shows while there is a slideshow to pause.
    const updateButton = () => {
      button.hidden = !started || motion.matches || next < 0;
    };
    const imgOf = (index: number) => slides[index].querySelector('img');
    const decode = (index: number) => {
      const img = imgOf(index);
      return img ? img.decode().then(() => true, () => false) : Promise.resolve(false);
    };

    // Put the following photo, still invisible, on top of the current one so the
    // browser downloads and decodes it while the current one is on screen.
    const queueNext = () => {
      next = -1;
      for (let k = 1; k < slides.length; k++) {
        const i = (current + k) % slides.length;
        if (!failed.has(i)) {
          next = i;
          break;
        }
      }
      if (next >= 0) {
        const slide = slides[next];
        const img = imgOf(next);
        if (img) img.loading = 'eager';
        moveUrls(slide, 'data-', '');
        slide.classList.add('is-next');
        nextReady = decode(next);
      }
      updateButton();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (canRun() && !busy) timer = window.setTimeout(advance, step - fade);
    };

    // Fade the queued photo in over the current one, then make it the current one.
    const advance = async () => {
      if (busy || !canRun()) return;
      busy = true;
      const ok = await nextReady;
      if (!ok) {
        const img = imgOf(next);
        if (img && img.complete && img.naturalWidth === 0) {
          // The photo is broken: leave it out and queue the one after it.
          failed.add(next);
          slides[next].classList.remove('is-next');
          moveUrls(slides[next], '', 'data-');
          queueNext();
        } else {
          // Decoding was interrupted (for example the screen rotated): try again next time.
          nextReady = decode(next);
        }
      } else if (canRun()) {
        const incoming = slides[next];
        const outgoing = slides[current];
        await incoming
          .animate([{ opacity: 0 }, { opacity: 1 }], { duration: fade, easing: 'linear', fill: 'forwards' })
          .finished.catch(() => undefined);
        outgoing.classList.remove('is-current');
        moveUrls(outgoing, '', 'data-');
        incoming.classList.replace('is-next', 'is-current');
        incoming.getAnimations().forEach((animation) => animation.cancel());
        current = next;
        queueNext();
      }
      busy = false;
      schedule();
    };

    button.addEventListener('click', () => {
      paused = !paused;
      hero.toggleAttribute('data-paused', paused);
      button.setAttribute('aria-pressed', String(paused));
      // A crossfade in progress freezes on the spot and carries on when resumed.
      hero.getAnimations({ subtree: true }).forEach((animation) => (paused ? animation.pause() : animation.play()));
      schedule();
    });

    // Rest while the hero is scrolled away or the tab is in the background.
    new IntersectionObserver((entries) => {
      inView = entries[entries.length - 1].isIntersecting;
      schedule();
    }).observe(hero);
    document.addEventListener('visibilitychange', schedule);

    // Follow the reduced-motion setting if it changes while the page is open.
    motion.addEventListener('change', () => {
      if (started && !motion.matches && next < 0) queueNext();
      updateButton();
      schedule();
    });

    // Photos that failed while offline get another chance once the connection is back.
    window.addEventListener('online', () => {
      failed.clear();
      if (started && !motion.matches && next < 0) queueNext();
      schedule();
    });

    // Start once the page has loaded (or, on a slow connection, once the first photo is
    // showing), so the other photos never compete with the first one.
    const start = () => {
      if (started) return;
      started = true;
      if (!motion.matches) queueNext();
      updateButton();
      schedule();
    };
    const first = imgOf(0);
    const firstShown = new Promise<void>((resolve) => {
      if (!first || first.complete) resolve();
      else {
        first.addEventListener('load', () => resolve(), { once: true });
        first.addEventListener('error', () => resolve(), { once: true });
      }
    });
    if (document.readyState === 'complete') start();
    else {
      window.addEventListener('load', start, { once: true });
      window.setTimeout(() => firstShown.then(start), 5000);
    }
  });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    /* Fills the screen, and grows instead of overlapping the header if the text needs more room (zoom, large text). */
    min-height: max(600px, 100svh);
    padding-top: calc(var(--header-h) + 32px);
    overflow: hidden;
    background: var(--ink);
    color: var(--cream);
  }

  @supports not (height: 100svh) {
    .hero {
      min-height: max(600px, 100vh);
    }
  }

  /* ---------- Slideshow ---------- */
  .hero__media {
    position: absolute;
    inset: 0;
    isolation: isolate;
  }

  /* Only the photo on screen and the one queued after it are rendered (and downloaded). */
  .hero__slide {
    position: absolute;
    inset: 0;
    display: none;
    opacity: 0;
  }

  .hero__slide.is-current {
    z-index: 1;
    display: block;
    opacity: 1;
  }

  /* The next photo waits invisibly on top of the current one; the script fades it in. */
  .hero__slide.is-next {
    z-index: 2;
    display: block;
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Legibility: darker behind the header, the text column and along the bottom. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(var(--ink-rgb), 0.7) 0,
        rgba(var(--ink-rgb), 0.62) 56px,
        rgba(var(--ink-rgb), 0) max(200px, 24%)
      ),
      linear-gradient(
        90deg,
        rgba(var(--ink-rgb), 0.8) 0,
        rgba(var(--ink-rgb), 0.6) calc(var(--edge) + 500px),
        rgba(var(--ink-rgb), 0) calc(var(--edge) + 900px)
      ),
      linear-gradient(0deg, rgba(var(--ink-rgb), 0.6) 0%, rgba(var(--ink-rgb), 0) 55%);
  }

  /* ---------- Text ---------- */
  /* Lines up with the logo above it and the page content below it. */
  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 var(--edge) clamp(64px, 12vh, 132px);
    text-shadow: 0 2px 18px rgba(var(--ink-rgb), 0.35);
  }

  .hero__text {
    max-width: 700px;
  }

  .hero__eyebrow {
    font-weight: 400;
    font-size: 15px;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__title {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(56px, 30px + 4.6vw, 116px);
    line-height: 1;
    letter-spacing: -0.005em;
  }

  .hero__lead {
    max-width: 30ch;
    margin-top: 22px;
    font-size: clamp(20px, 15px + 0.7vw, 27px);
    line-height: 1.35;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  /* Buttons use the shared .btn styles; on the photo they get a deeper shadow. */
  .hero__actions :global(.btn) {
    text-shadow: none;
  }

  .hero__cta {
    box-shadow: 0 14px 34px rgba(10, 14, 5, 0.38);
  }

  .hero__cta:hover {
    box-shadow: 0 18px 42px rgba(10, 14, 5, 0.48);
  }

  .hero__secondary {
    font-size: 18px;
  }

  .hero__cta:focus-visible,
  .hero__secondary:focus-visible,
  .hero__pause:focus-visible {
    outline: 3px solid var(--cream);
    outline-offset: 3px;
  }

  .hero__note {
    margin-top: 22px;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.4;
    opacity: 0.88;
  }

  /* ---------- Pause button ---------- */
  .hero__pause {
    position: absolute;
    right: var(--edge);
    bottom: 24px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(255, 253, 246, 0.6);
    border-radius: 50%;
    background: rgba(var(--ink-rgb), 0.35);
    color: var(--cream);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  /* Shown by the script only when the slideshow actually runs. */
  .hero__pause[hidden] {
    display: none;
  }

  .hero__pause:hover {
    background: rgba(var(--ink-rgb), 0.6);
  }

  .hero__icon-play,
  .hero[data-paused] .hero__icon-pause {
    display: none;
  }

  .hero[data-paused] .hero__icon-play {
    display: block;
  }

  /* ---------- Portrait screens (phones, upright tablets) ---------- */
  @media (max-aspect-ratio: 1/1) {
    .hero__scrim {
      background:
        linear-gradient(
          180deg,
          rgba(var(--ink-rgb), 0.7) 0,
          rgba(var(--ink-rgb), 0.62) 56px,
          rgba(var(--ink-rgb), 0) max(200px, 30%)
        ),
        linear-gradient(0deg, rgba(var(--ink-rgb), 0.9) 0%, rgba(var(--ink-rgb), 0.62) 40%, rgba(var(--ink-rgb), 0) 70%);
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 767.98px) {
    .hero__content {
      padding-bottom: calc(70 * var(--m));
    }

    .hero__eyebrow {
      font-size: calc(12 * var(--m));
      letter-spacing: 0.14em;
    }

    .hero__title {
      margin-top: calc(12 * var(--m));
      font-size: calc(48 * var(--m));
    }

    .hero__lead {
      margin-top: calc(14 * var(--m));
      font-size: calc(18 * var(--m));
    }

    .hero__actions {
      flex-direction: column;
      gap: calc(10 * var(--m));
      margin-top: calc(26 * var(--m));
    }

    .hero__cta,
    .hero__secondary {
      width: 100%;
      min-height: calc(50 * var(--m));
    }

    .hero__cta {
      font-size: calc(18 * var(--m));
    }

    .hero__secondary {
      font-size: calc(16 * var(--m));
    }

    .hero__note {
      margin-top: calc(16 * var(--m));
      font-size: calc(13 * var(--m));
    }

    .hero__pause {
      bottom: calc(20 * var(--m));
      width: 36px;
      height: 36px;
    }
  }

  /*
   * Upright phones: on a tall, narrow photo the text starts in the middle of the
   * picture, so it gets its own shade that follows the text block.
   */
  @media (max-aspect-ratio: 1/1) and (max-width: 767.98px) {
    .hero__content::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: -100px 0 0;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        rgba(var(--ink-rgb), 0) 0,
        rgba(var(--ink-rgb), 0.62) 100px,
        rgba(var(--ink-rgb), 0.5) 30%,
        rgba(var(--ink-rgb), 0) 60%
      );
    }
  }

  /* Short phones: drop the small print (repeated further down the page) so the button stays on screen. */
  @media (max-width: 767.98px) and (max-height: 740px) {
    .hero__note {
      display: none;
    }

    .hero__content {
      padding-bottom: calc(62 * var(--m));
    }

    .hero__title {
      font-size: calc(44 * var(--m));
    }
  }

  /* Phones on their side: compact layout so the call to action stays on screen. */
  @media (orientation: landscape) and (max-height: 520px) {
    .hero {
      min-height: max(340px, 100svh);
      padding-top: calc(var(--header-h) + 16px);
    }

    .hero__content {
      padding-bottom: 26px;
    }

    .hero__note {
      display: none;
    }

    .hero__eyebrow {
      font-size: 12px;
      letter-spacing: 0.14em;
    }

    .hero__title {
      margin-top: 8px;
      font-size: 44px;
    }

    .hero__lead {
      margin-top: 10px;
      font-size: 18px;
    }

    .hero__actions {
      flex-direction: row;
      margin-top: 18px;
    }

    .hero__cta,
    .hero__secondary {
      width: auto;
      min-height: 48px;
      padding-inline: 22px;
    }

    .hero__cta {
      font-size: 18px;
    }

    .hero__secondary {
      font-size: 16px;
    }
  }

  @supports not (height: 100svh) {
    @media (orientation: landscape) and (max-height: 520px) {
      .hero {
        min-height: max(340px, 100vh);
      }
    }
  }
</style>
