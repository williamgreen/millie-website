---
/**
 * Opening block for inner pages: a pastel colour band with an eyebrow label,
 * a large Forum title, an optional lead (default slot), optional buttons
 * (slot="actions") and an optional rounded image.
 *
 *   <PageHeader eyebrow="About" title="..." image={photo} imageAlt="...">
 *     <p>Lead text…</p>
 *     <Fragment slot="actions"><a class="btn" href="...">…</a></Fragment>
 *   </PageHeader>
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title: string;
  tone?: 'sage' | 'cream' | 'mist' | 'lime';
  image?: ImageMetadata;
  imageAlt?: string;
  /** CSS object-position for the image crop, e.g. "50% 20%". */
  imagePosition?: string;
  /** Aspect ratio of the image box, e.g. "4 / 5". */
  imageRatio?: string;
  /** Use "md" for long titles so they don't run over four lines. */
  size?: 'lg' | 'md';
}

const {
  eyebrow,
  title,
  tone = 'sage',
  image,
  imageAlt = '',
  imagePosition = '50% 50%',
  imageRatio = '4 / 5',
  size = 'lg',
} = Astro.props;
const hasLead = Astro.slots.has('default');
const hasActions = Astro.slots.has('actions');
---

<section class:list={['page-header', `section--${tone}`, { 'page-header--media': image }]}>
  <div class="container page-header__inner">
    <div class="page-header__text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class:list={['display', 'page-header__title', { 'page-header__title--md': size === 'md' }]}>{title}</h1>
      {
        hasLead && (
          <div class="page-header__lead lead">
            <slot />
          </div>
        )
      }
      {
        hasActions && (
          <div class="btn-row page-header__actions">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      image && (
        <div class="page-header__media rounded" style={`aspect-ratio: ${imageRatio}`}>
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 900px) 45vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="media-cover"
            style={`object-position: ${imagePosition}`}
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(56px, 7vw, 120px) clamp(64px, 8vw, 128px);
  }

  .page-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .page-header--media .page-header__inner {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  }

  .page-header__text {
    max-width: 900px;
  }

  .page-header__title--md {
    font-size: clamp(40px, 26px + 3.2vw, 78px);
    line-height: 1.04;
  }

  .page-header__lead {
    max-width: 40ch;
    margin-top: clamp(20px, 2.5vw, 30px);
  }

  .page-header__lead :global(p + p) {
    margin-top: 0.8em;
  }

  .page-header__actions {
    margin-top: clamp(28px, 3.5vw, 40px);
  }

  .page-header__media {
    width: 100%;
    max-height: 78vh;
  }

  @media (max-width: 899.98px) {
    .page-header--media .page-header__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Stacked under the text: never taller than most of the screen. */
    .page-header__media {
      max-height: min(75vh, 640px);
    }
  }
</style>
