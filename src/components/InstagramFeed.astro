---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { site } from '../data/site';
import { instagramPosts } from '../data/instagram';

const hasPosts = instagramPosts.length > 0;
---

<section class="section section--mist ig" aria-labelledby="ig-title">
  <div class="container">
    <div class="section-head section-head--center ig__head">
      <p class="eyebrow">Instagram</p>
      <h2 class="h2" id="ig-title">
        <a href={site.instagram.url} target="_blank" rel="noopener">Follow me {site.instagram.handle}</a>
      </h2>
    </div>
  </div>

  {
    hasPosts && (
      <div class="ig__slider" data-ig-slider>
        <ul class="ig__track" data-ig-track>
          {instagramPosts.map((post, i) => (
            <li class="ig__item">
              <a href={post.href} target="_blank" rel="noopener">
                <Image
                  src={post.image}
                  alt={post.alt}
                  widths={[320, 500, 750, 1000]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 600px) 40vw, 75vw"
                  loading={i < 4 ? 'eager' : 'lazy'}
                />
              </a>
            </li>
          ))}
        </ul>
        <div class="ig__controls">
          <button class="ig__arrow" type="button" data-ig-prev disabled>
            <span class="visually-hidden">Previous posts</span>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" fill="none" />
            </svg>
          </button>
          <button class="ig__arrow" type="button" data-ig-next>
            <span class="visually-hidden">Next posts</span>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" fill="none" />
            </svg>
          </button>
        </div>
      </div>
    )
  }

  <div class="ig__more">
    <a class="btn btn--outline" href={site.instagram.url} target="_blank" rel="noopener">
      View on Instagram <Arrow />
    </a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ig-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('[data-ig-track]');
    const prev = slider.querySelector<HTMLButtonElement>('[data-ig-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-ig-next]');
    if (!track || !prev || !next) return;

    const step = () => (track.querySelector<HTMLElement>('.ig__item')?.offsetWidth ?? track.clientWidth) + 16;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .ig__head {
    margin-bottom: 0;
  }

  .ig__head a {
    text-decoration: none;
  }

  .ig__head a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .ig__slider {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .ig__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 16px - 2 * var(--gutter)) / 4);
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
  }

  .ig__track::-webkit-scrollbar {
    display: none;
  }

  .ig__item {
    scroll-snap-align: start;
  }

  .ig__item a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .ig__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ig__item a:hover :global(img) {
    transform: scale(1.04);
  }

  .ig__controls {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }

  .ig__arrow {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 1px solid var(--olive);
    border-radius: 50%;
    background: transparent;
    color: var(--olive);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ig__arrow:hover:not(:disabled) {
    background: rgba(var(--olive-rgb), 0.08);
  }

  .ig__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .ig__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(32px, 4vw, 48px);
    padding-inline: var(--gutter);
  }

  @media (max-width: 1023.98px) {
    .ig__track {
      grid-auto-columns: calc((100% - 16px - 2 * var(--gutter)) / 2.3);
    }
  }

  @media (max-width: 599.98px) {
    .ig__track {
      grid-auto-columns: 72%;
    }
  }
</style>
