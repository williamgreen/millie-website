---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { instagramPosts } from '../data/instagram';

const hasPosts = instagramPosts.length > 0;
---

<section class="ig" aria-labelledby="ig-title">
  <h2 class="ig__title" id="ig-title">
    <a href={site.instagram.url} target="_blank" rel="noopener">Follow me {site.instagram.handle}</a>
  </h2>

  {
    hasPosts && (
      <div class="ig__slider" data-ig-slider>
        <ul class="ig__track" data-ig-track>
          {instagramPosts.map((post, i) => (
            <li class="ig__item">
              <a href={post.href} target="_blank" rel="noopener">
                <Image
                  src={post.image}
                  alt={post.alt}
                  widths={[320, 500, 750, 1000]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 600px) 45vw, 80vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                />
              </a>
            </li>
          ))}
        </ul>
        <button class="ig__arrow ig__arrow--prev" type="button" data-ig-prev hidden>
          <span class="visually-hidden">Previous posts</span>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" fill="none" />
          </svg>
        </button>
        <button class="ig__arrow ig__arrow--next" type="button" data-ig-next hidden>
          <span class="visually-hidden">Next posts</span>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" fill="none" />
          </svg>
        </button>
      </div>
    )
  }

  <div class="ig__more">
    <a class="btn-outline" href={site.instagram.url} target="_blank" rel="noopener">View on Instagram</a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ig-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('[data-ig-track]');
    const prev = slider.querySelector<HTMLButtonElement>('[data-ig-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-ig-next]');
    if (!track || !prev || !next) return;

    const step = () => (track.querySelector<HTMLElement>('.ig__item')?.offsetWidth ?? track.clientWidth) + 2;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.hidden = track.scrollLeft <= 2;
      next.hidden = track.scrollLeft >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .ig {
    background: var(--lime);
    padding: 61px 0 96px;
  }

  .ig__title {
    width: min(100% - 2 * var(--gutter), 1100px);
    margin-inline: auto;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(46px, 27px + 5.2vw, 96px);
    line-height: 1.4;
    text-align: center;
  }

  .ig__title a {
    text-decoration: none;
  }

  .ig__slider {
    position: relative;
    margin-top: 64px;
  }

  .ig__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4px) / 3);
    gap: 2px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ig__track::-webkit-scrollbar {
    display: none;
  }

  .ig__item {
    scroll-snap-align: start;
  }

  .ig__item a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .ig__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ig__item a:hover img {
    transform: scale(1.03);
  }

  .ig__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 253, 246, 0.85);
    color: var(--olive);
    cursor: pointer;
  }

  .ig__arrow[hidden] {
    display: none;
  }

  .ig__arrow--prev {
    left: 20px;
  }

  .ig__arrow--next {
    right: 20px;
  }

  .ig__more {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }

  @media (max-width: 1023.98px) {
    .ig__track {
      grid-auto-columns: calc((100% - 2px) / 2);
    }
  }

  @media (max-width: 767.98px) {
    .ig {
      padding: calc(33 * var(--m)) 0 calc(72 * var(--m));
    }

    .ig__title {
      font-size: calc(49 * var(--m));
    }

    .ig__slider {
      margin-top: calc(32 * var(--m));
    }

    .ig__more {
      margin-top: calc(40 * var(--m));
    }
  }

  @media (max-width: 599.98px) {
    .ig__track {
      grid-auto-columns: 82%;
    }
  }
</style>
