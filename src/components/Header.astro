---
import LeafMark from './LeafMark.astro';
import Arrow from './Arrow.astro';
import EmailText from './EmailText.astro';
import { nav, site } from '../data/site';
import { cleanPath } from '../utils/paths';

interface Props {
  /** Float the header over a full-screen hero (transparent, light text). */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const current = cleanPath(Astro.url.pathname);
const isCurrent = (href: string) => (href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`));
const bookHref = '/service-page/free-phone-consultation-1';
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="site-header__inner">
    <a class="brand" href="/">
      <LeafMark class="brand__mark" />
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Site">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--sm site-header__cta" href={bookHref}>Book a Free Call</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="visually-hidden">Open site navigation</span>
        <span class="menu-toggle__lines" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site navigation" hidden>
    <div class="mobile-menu__bar">
      <a class="brand" href="/">
        <LeafMark class="brand__mark" />
        <span class="brand__name">{site.name}</span>
      </a>
      <button class="mobile-menu__close" type="button">
        <span class="visually-hidden">Close site navigation</span>
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" fill="none"></path>
        </svg>
      </button>
    </div>
    <nav class="mobile-menu__nav" aria-label="Site (mobile)">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu__footer">
      <a class="btn btn--block" href={bookHref}>Book a Free Call <Arrow /></a>
      <p class="mobile-menu__contact">
        <a href={`mailto:${site.email}`}><EmailText /></a>
        <a href={site.instagram.url} target="_blank" rel="noopener">Instagram {site.instagram.handle}</a>
      </p>
    </div>
  </div>

  <noscript>
    <style>
      .menu-toggle {
        display: none !important;
      }
      .site-nav {
        display: block !important;
      }
      .site-header__inner {
        flex-wrap: wrap;
        height: auto !important;
        padding-block: 14px !important;
      }
      .site-nav ul {
        flex-wrap: wrap;
        row-gap: 4px;
      }
      .site-header--overlay {
        position: relative !important;
        background: var(--ink) !important;
      }
    </style>
  </noscript>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('.mobile-menu__close');

  if (toggle && menu && closeBtn) {
    // While the full-screen menu is open, everything behind it is inert: keyboard and
    // screen reader users stay inside the menu instead of landing on hidden content.
    const behind = ['.skip-link', '.site-header__inner', '#main', '.site-footer']
      .map((selector) => document.querySelector<HTMLElement>(selector))
      .filter((el): el is HTMLElement => el !== null);
    const setBehindInert = (inert: boolean) => behind.forEach((el) => (el.inert = inert));

    const open = () => {
      menu.hidden = false;
      setBehindInert(true);
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('menu-open');
      menu.querySelector<HTMLAnchorElement>('.mobile-menu__nav a')?.focus();
    };
    const close = (restoreFocus = true) => {
      menu.hidden = true;
      setBehindInert(false);
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('menu-open');
      if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', () => close());
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) close(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) close();
    });
    // If the window grows to full-navigation size while the menu is open, close it.
    window.matchMedia('(min-width: 1240px)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) close(false);
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--cream);
    border-bottom: 1px solid var(--hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 32px);
    min-height: var(--header-h);
    padding-inline: var(--edge);
  }

  /* ---------- Brand ---------- */
  /* The logo may shrink (and wrap) if text is enlarged; the buttons beside it never do. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--olive);
    text-decoration: none;
  }

  .brand :global(.brand__mark) {
    width: 24px;
    height: 23px;
    flex-shrink: 0;
  }

  .brand__name {
    padding-top: 3px;
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.2;
  }

  /* ---------- Desktop navigation ---------- */
  .site-nav {
    display: none;
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    /* Tighter just above 1240px, where the nav first appears, so it fits in any font. */
    gap: 0 clamp(14px, 3.8vw - 33px, 26px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: block;
    padding: 8px 0;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 7px;
    transition:
      text-decoration-color 0.3s ease,
      color 0.3s ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    text-decoration-color: currentColor;
  }

  .site-header__actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .site-header__cta {
    box-shadow: none;
    white-space: nowrap;
  }

  /* ---------- Hamburger ---------- */
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-right: -8px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-toggle__lines {
    display: grid;
    gap: 6px;
    width: 24px;
  }

  .menu-toggle__lines span {
    display: block;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
  }

  @media (min-width: 1240px) {
    .site-nav {
      display: block;
    }

    .site-header__actions {
      margin-left: 8px;
    }

    .menu-toggle {
      display: none;
    }
  }

  /* Phones: just the brand and the menu button; the call to action is in the menu. */
  @media (max-width: 599.98px) {
    .site-header__cta {
      display: none;
    }

    .brand__name {
      font-size: 19px;
    }
  }

  /* ---------- Mobile menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background: var(--cream);
    color: var(--olive);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    padding-inline: var(--edge);
    border-bottom: 1px solid var(--hairline);
    background: var(--cream);
  }

  .mobile-menu__close {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-right: -8px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--olive);
    cursor: pointer;
  }

  .mobile-menu__nav {
    padding: clamp(24px, 6vh, 56px) var(--edge) 24px;
  }

  .mobile-menu__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu__nav a {
    display: block;
    padding: 8px 0;
    font-family: var(--font-serif);
    font-size: clamp(30px, 6vw + 8px, 44px);
    line-height: 1.15;
    color: var(--olive);
    text-decoration: none;
  }

  .mobile-menu__nav a[aria-current='page'] {
    color: var(--olive-soft);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 8px;
  }

  .mobile-menu__footer {
    display: grid;
    gap: 22px;
    margin-top: auto;
    padding: 24px var(--edge) clamp(28px, 5vh, 48px);
  }

  /* Full-width button on phones only; on tablets it sits under the links at its own size. */
  @media (min-width: 600px) {
    .mobile-menu__footer {
      justify-items: start;
    }

    .mobile-menu__footer .btn {
      width: auto;
    }
  }

  .mobile-menu__contact {
    display: grid;
    gap: 6px;
    font-size: var(--text-small);
  }

  .mobile-menu__contact a {
    text-decoration: none;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  /* ---------- Overlay variant (home page hero) ---------- */
  .site-header--overlay {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    background: transparent;
    border-bottom-color: rgba(255, 253, 246, 0.18);
    color: var(--cream);
  }

  .site-header--overlay .site-header__inner .brand,
  .site-header--overlay .site-nav a {
    color: var(--cream);
    text-shadow: 0 1px 14px rgba(var(--ink-rgb), 0.45);
  }

  .site-header--overlay .site-nav a:hover,
  .site-header--overlay .site-nav a[aria-current='page'] {
    color: var(--lime);
  }

  .site-header--overlay .site-header__inner :focus-visible {
    outline-color: var(--lime);
  }
</style>
